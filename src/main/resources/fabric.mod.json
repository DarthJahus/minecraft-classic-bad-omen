{
  "schemaVersion": 1,
  "id": "classicbadomen",
  "version": "${version}",
  "name": "Classic Bad Omen",
  "description": "Restores instant Bad Omen when a raid captain would drop an ominous bottle. Intercepts the vanilla drop path; configurable probability, bottle policy (otherwise/always/never), and level mode (stack or drop).",
  "authors": ["Jahus"],
  "contact": {
    "homepage": "https://mc.jahus.net/projects",
    "sources": "https://github.com/DarthJahus/minecraft-classicbadomen",
    "issues": "https://github.com/DarthJahus/minecraft-classicbadomen/issues"
  },
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "main": ["net.jahus.classicbadomen.ClassicBadOmen"]
  },
  "mixins": ["classicbadomen.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
